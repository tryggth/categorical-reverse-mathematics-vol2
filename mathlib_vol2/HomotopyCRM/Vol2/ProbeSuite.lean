/-- Probe theory `Th_𝒫(U) = { p | ∀ d, U d → d ⊨ p }`. -/
def probeTheory {D P : Type} {Φ : DoctrinalProblem D} (S : ProbeSuite Φ P)
    (U : D → Prop) : P → Prop :=
  fun p ↦ ∀ d, U d → S.sat d p

/-- Definable extent `Ext_𝒫(Q) = { d | ∀ p, Q p → d ⊨ p }`. -/
def probeExtent {D P : Type} {Φ : DoctrinalProblem D} (S : ProbeSuite Φ P)
    (Q : P → Prop) : D → Prop :=
  fun d ↦ ∀ p, Q p → S.sat d p

/-- Galois/Moore closure `Cl_𝒫(U) = Ext_𝒫(Th_𝒫(U))`. -/
def mooreClosure {D P : Type} {Φ : DoctrinalProblem D} (S : ProbeSuite Φ P)
    (U : D → Prop) : D → Prop :=
  probeExtent S (probeTheory S U)

/-- Predicate inclusion `E₁ ⊆ E₂`. -/
def ExtentSub {D : Type} (E₁ E₂ : D → Prop) : Prop :=
  ∀ d, E₁ d → E₂ d

/-- Deductive refinement `E₁ ≼ E₂` (`E₁` is deductively stronger: `E₁ ⊆ E₂`). -/
def Refines {D : Type} (E₁ E₂ : D → Prop) : Prop :=
  ExtentSub E₁ E₂

/-- `E` is Moore-closed when `Cl_𝒫(E) ⊆ E`. -/
def IsClosedExtent {D P : Type} {Φ : DoctrinalProblem D} (S : ProbeSuite Φ P)
    (E : D → Prop) : Prop :=
  ExtentSub (mooreClosure S E) E

/-- Admissible residuum extent: `𝒫`-closed with `K ⊆ E ⊆ T`. -/
def IsAdmissible {D P : Type} {Φ : DoctrinalProblem D} (S : ProbeSuite Φ P)
    (E : D → Prop) : Prop :=
  -- BEGIN_BODY ch01:def:adm-pareto-frontier
  IsClosedExtent S E ∧ ExtentSub Φ.K E ∧ ExtentSub E Φ.T
-- END_BODY ch01:def:adm-pareto-frontier

/-- Epistemic Scotoma: no admissible `𝒫`-closed extent exists (`Adm_𝒫 = ∅`). -/
def IsScotoma {D P : Type} {Φ : DoctrinalProblem D} (S : ProbeSuite Φ P) : Prop :=
  IsEmpty { E : D → Prop // IsAdmissible S E }

/-- Epistemic Aperture: at least one admissible `𝒫`-closed extent exists (`Adm_𝒫 ≠ ∅`). -/
def HasAperture {D P : Type} {Φ : DoctrinalProblem D} (S : ProbeSuite Φ P) : Prop :=
  Nonempty { E : D → Prop // IsAdmissible S E }

/-- Inclusion-maximal (deductively weakest) admissible extents forming `Res_𝒫^min`. -/
def InParetoFrontier {D P : Type} {Φ : DoctrinalProblem D} (S : ProbeSuite Φ P)
    (E : D → Prop) : Prop :=
  IsAdmissible S E ∧ ∀ E', IsAdmissible S E' → ExtentSub E E' → ExtentSub E' E

/-- Dogma regime: Assertoric Closure `T` itself is `𝒫`-closed. -/
def IsDogma {D P : Type} {Φ : DoctrinalProblem D} (S : ProbeSuite Φ P) : Prop :=
  IsClosedExtent S Φ.T

