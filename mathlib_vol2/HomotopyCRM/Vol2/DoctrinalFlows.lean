    IsSubterminalE Y →
    ∃ (W : ObjE) (q : HomE X W) (m : HomE W Y),
      IsSubterminalE W ∧ IsEpiE q ∧ IsMonoE m ∧ compE m q = f
  /-- Exactness of `a_j` turns `m` into an epi+mono hence isomorphism in the balanced topos `Sh_j(E)`. -/
  a_mono_of_sheafEpi_iso : ∀ {X V : ObjS} (p : HomS X V) {W : ObjE}
    (q : HomE (iObj X) W) (m : HomE W (iObj V)),
    IsEpiS p → IsEpiE q → IsMonoE m → compE m q = iMap p →
    ∃ mInv : HomS (aObj (iObj V)) (aObj W),
      compS (aMap m) mInv = idS (aObj (iObj V))

/-- Ambient `Proj_sub`: every epimorphism onto a subterminal splits in `E`. -/
def HasProjSubE (R : ReflectiveSubterminalSystem) : Prop :=
  ∀ {X W : R.ObjE} (q : R.HomE X W), R.IsSubterminalE W → R.IsEpiE q →
    ∃ s : R.HomE W X, R.compE q s = R.idE W

/-- Subtopos `Proj_sub`: every epimorphism onto a subterminal splits in `Sh_j(E)`. -/
def HasProjSubS (R : ReflectiveSubterminalSystem) : Prop :=
  ∀ {X V : R.ObjS} (p : R.HomS X V), R.IsSubterminalS V → R.IsEpiS p →
    ∃ σ : R.HomS V X, R.compS p σ = R.idS V

/-- Concrete inhabited witness of `ReflectiveSubterminalSystem`. -/
def unitReflectiveSystem : ReflectiveSubterminalSystem where
  ObjE := PUnit
  HomE _ _ := PUnit
  idE _ := ()
  compE _ _ := ()
  IsSubterminalE _ := True
  IsEpiE _ := True
  IsMonoE _ := True
  ObjS := PUnit
  HomS _ _ := PUnit
  idS _ := ()
  compS _ _ := ()
  assocS _ _ _ := rfl
  id_compS _ := rfl
  comp_idS _ := rfl
  IsSubterminalS _ := True
  IsEpiS _ := True
  iObj x := x
  iMap f := f
  aObj x := x
  aMap f := f
  a_id _ := rfl
  a_comp _ _ := rfl
  eps _ := ()
  epsInv _ := ()
  eps_inv_right _ := rfl
  eps_nat _ := rfl
  i_preserves_subterminal _ _ := trivial
  epiMonoFactor _ _ := ⟨(), (), (), trivial, trivial, trivial, rfl⟩
  a_mono_of_sheafEpi_iso := by intros; exact ⟨(), rfl⟩

/-- **Witness Core (`reflective_preserves_projSub`):** Diagram-chase transport of `Proj_sub` from
    `E` to `Sh_j(E)` via epi-mono factorization and sheafification reflection (zero axioms). -/
theorem reflective_preserves_projSub (R : ReflectiveSubterminalSystem)
    (hE : HasProjSubE R) : HasProjSubS R := by
  -- BEGIN_BODY ch01:prop:lt-stability-projsub
  intro X V p hV hp
  have hiV : R.IsSubterminalE (R.iObj V) := R.i_preserves_subterminal V hV
  rcases R.epiMonoFactor (R.iMap p) hiV with ⟨W, q, m, hW, hq, hm, hfac⟩
  rcases hE q hW hq with ⟨s, hs⟩
  rcases R.a_mono_of_sheafEpi_iso p q m hp hq hm hfac with ⟨mInv, hmInv⟩
  refine ⟨R.compS (R.eps X) (R.compS (R.aMap s) (R.compS mInv (R.epsInv V))), ?_⟩
  calc
    R.compS p (R.compS (R.eps X) (R.compS (R.aMap s) (R.compS mInv (R.epsInv V))))
      = R.compS (R.compS p (R.eps X)) (R.compS (R.aMap s) (R.compS mInv (R.epsInv V))) := by
          rw [← R.assocS]
    _ = R.compS (R.compS (R.eps V) (R.aMap (R.iMap p)))
          (R.compS (R.aMap s) (R.compS mInv (R.epsInv V))) := by
          rw [R.eps_nat p]
    _ = R.compS (R.eps V) (R.compS (R.aMap (R.compE m q))
          (R.compS (R.aMap s) (R.compS mInv (R.epsInv V)))) := by
          rw [← hfac, R.assocS]
    _ = R.compS (R.eps V) (R.compS (R.compS (R.aMap m) (R.aMap q))
          (R.compS (R.aMap s) (R.compS mInv (R.epsInv V)))) := by
          rw [R.a_comp m q]
    _ = R.compS (R.eps V) (R.compS (R.aMap m)
          (R.compS (R.compS (R.aMap q) (R.aMap s)) (R.compS mInv (R.epsInv V)))) := by
          rw [R.assocS, ← R.assocS (R.aMap q)]
    _ = R.compS (R.eps V) (R.compS (R.aMap m)
          (R.compS (R.aMap (R.compE q s)) (R.compS mInv (R.epsInv V)))) := by
          rw [← R.a_comp q s]
    _ = R.compS (R.eps V) (R.compS (R.aMap m) (R.compS mInv (R.epsInv V))) := by
          rw [hs, R.a_id W, R.id_compS]
    _ = R.compS (R.eps V) (R.compS (R.compS (R.aMap m) mInv) (R.epsInv V)) := by
          rw [← R.assocS (R.aMap m)]
    _ = R.compS (R.eps V) (R.epsInv V) := by
          rw [hmInv, R.id_compS]
    _ = R.idS V := R.eps_inv_right V
-- END_BODY ch01:prop:lt-stability-projsub

/-- info: 'HomotopyCRM.Vol2.reflective_preserves_projSub' does not depend on any axioms -/
#guard_msgs in
#print axioms reflective_preserves_projSub
-- END_NODE ch01:prop:lt-stability-projsub

-- BEGIN_NODE ch01:thm:flow-f2-four-rung-escalation [spec:ad78ce8e body:cfb6d2f0]
/-- Concrete 7-topos witness universe separating the four Flow F2 stability rungs. -/
inductive FlowF2Witness : Type
  | scone        -- Set^{(B(Z/2Z))_⊥}
  | coscone      -- Set^{(B(Z/2Z))^⊤}
  | monoidZ2Zero -- Set^{(Z/2Z)^0}
  | m1Topos      -- Set^{ℳ₁}
  | setZ2        -- Set^{Z/2Z} (in Mod(IAC) \ Mod(AC), outside T)
  | setTopos     -- Set (∈ T)
  | termTopos    -- 1 (degenerate topos ∈ T)
  deriving DecidableEq

/-- Membership in Assertoric Closure `T = Mod(IAC → AC)` across the witness suite. -/
def flowF2InT : FlowF2Witness → Bool
  | .scone => true
  | .coscone => true
  | .monoidZ2Zero => true
  | .m1Topos => true
  | .setZ2 => false
  | .setTopos => true
  | .termTopos => true

/-- Open-subtopos closure image of each witness topos. -/
def flowF2OpenTargets : FlowF2Witness → List FlowF2Witness
  | .scone => [.scone, .setZ2, .termTopos]
  | .coscone => [.coscone, .setTopos, .termTopos]
  | .monoidZ2Zero => [.monoidZ2Zero, .termTopos]
  | .m1Topos => [.m1Topos, .termTopos]
  | .setZ2 => [.setZ2, .termTopos]
  | .setTopos => [.setTopos, .termTopos]
  | .termTopos => [.termTopos]

/-- Lawvere–Tierney sheaf closure image of each witness topos. -/
def flowF2LTTargets : FlowF2Witness → List FlowF2Witness
  | .scone => [.scone, .setZ2, .setTopos, .termTopos]
  | .coscone => [.coscone, .setZ2, .setTopos, .termTopos]
  | .monoidZ2Zero => [.monoidZ2Zero, .setTopos, .termTopos]
  | .m1Topos => [.m1Topos, .setTopos, .termTopos]
  | .setZ2 => [.setZ2, .termTopos]
  | .setTopos => [.setTopos, .termTopos]
  | .termTopos => [.termTopos]

/-- Slice + Lawvere–Tierney closure image of each witness topos. -/
def flowF2SliceLTTargets : FlowF2Witness → List FlowF2Witness
  | .scone => [.scone, .setZ2, .setTopos, .termTopos]
  | .coscone => [.coscone, .setZ2, .setTopos, .termTopos]
  | .monoidZ2Zero => [.monoidZ2Zero, .setZ2, .setTopos, .termTopos]
  | .m1Topos => [.m1Topos, .setTopos, .termTopos]
  | .setZ2 => [.setZ2, .termTopos]
  | .setTopos => [.setTopos, .termTopos]
  | .termTopos => [.termTopos]

/-- Trivial stability class `C_triv`. -/
def inCTriv (w : FlowF2Witness) : Bool := flowF2InT w

/-- Open-subtopos stability class `C_open`. -/
def inCOpen (w : FlowF2Witness) : Bool := (flowF2OpenTargets w).all flowF2InT

/-- Lawvere–Tierney stability class `C_LT`. -/
def inCLT (w : FlowF2Witness) : Bool := (flowF2LTTargets w).all flowF2InT

/-- Slice + Lawvere–Tierney stability class `C_slice+LT`. -/
def inCSliceLT (w : FlowF2Witness) : Bool := (flowF2SliceLTTargets w).all flowF2InT

/-- Three-point `ℳ₁`-set `X = {u₁, u₂, z}` with `e₁ • u₁ = e₁ • u₂ = e₁ • z = z`. -/
inductive M1VSliceObj : Type
  | u1
  | u2
  | z
  deriving DecidableEq

/-- Inhabited presheaf over `∫_{ℳ₁} X` with `F(u₁) = {false}`, `F(u₂) = {true}`, `F(z) = Bool`. -/
def m1VSliceFiber : M1VSliceObj → Type
  | .u1 => { b : Bool // b = false }
  | .u2 => { b : Bool // b = true }
  | .z => Bool

/-- `e₁`-action transport inside the slice fiber `F`. -/
def m1VSliceAct : ∀ x : M1VSliceObj, m1VSliceFiber x → m1VSliceFiber .z
  | .u1, b => b.1
  | .u2, b => b.1
  | .z, b => b

/-- Étale slice `(Set^{ℳ₁})/X` over `X = {u₁, u₂, z}` refutes `Proj₁` (hence `Proj_sub`). -/
theorem m1_etale_slice_refutes_proj1 :
    (∀ x : M1VSliceObj, Nonempty (m1VSliceFiber x)) ∧
    ¬ ∃ s : (x : M1VSliceObj) → m1VSliceFiber x,
        ∀ x : M1VSliceObj, m1VSliceAct x (s x) = s .z := by
  refine ⟨fun x ↦ ?_, ?_⟩
  · cases x
    · exact ⟨⟨false, rfl⟩⟩
    · exact ⟨⟨true, rfl⟩⟩
    · exact ⟨false⟩
  · rintro ⟨s, hs⟩
    have h1 : (s .u1).1 = s .z := hs .u1
    have h2 : (s .u2).1 = s .z := hs .u2
    have hf : false = s .z := (s .u1).2.symm.trans h1
    have ht : true = s .z := (s .u2).2.symm.trans h2
    exact Bool.noConfusion (hf.trans ht.symm)

/-- Strict four-rung Flow F2 escalation `C_triv ⊃neq C_open ⊃neq C_LT ⊃neq C_slice+LT` (zero axioms). -/
theorem flow_f2_four_rung_strict_escalation :
    (∀ w, inCSliceLT w = true → inCLT w = true) ∧
    (∀ w, inCLT w = true → inCOpen w = true) ∧
    (∀ w, inCOpen w = true → inCTriv w = true) ∧
    (inCTriv .scone = true ∧ inCOpen .scone = false) ∧
    (inCOpen .coscone = true ∧ inCLT .coscone = false) ∧
    (inCLT .monoidZ2Zero = true ∧ inCSliceLT .monoidZ2Zero = false) ∧
    (inCSliceLT .m1Topos = true) := by
  -- BEGIN_BODY ch01:thm:flow-f2-four-rung-escalation
  refine ⟨?_, ?_, ?_, ⟨rfl, rfl⟩, ⟨rfl, rfl⟩, ⟨rfl, rfl⟩, rfl⟩
  · intro w hw
    match w with
    | .scone => exact False.elim (Bool.noConfusion hw)
    | .coscone => exact False.elim (Bool.noConfusion hw)
    | .monoidZ2Zero => exact False.elim (Bool.noConfusion hw)
    | .m1Topos => rfl
    | .setZ2 => exact False.elim (Bool.noConfusion hw)
    | .setTopos => rfl
    | .termTopos => rfl
  · intro w hw
    match w with
    | .scone => exact False.elim (Bool.noConfusion hw)
    | .coscone => exact False.elim (Bool.noConfusion hw)
    | .monoidZ2Zero => rfl
    | .m1Topos => rfl
    | .setZ2 => exact False.elim (Bool.noConfusion hw)
    | .setTopos => rfl
    | .termTopos => rfl
  · intro w hw
    match w with
    | .scone => rfl
    | .coscone => rfl
    | .monoidZ2Zero => rfl
    | .m1Topos => rfl
    | .setZ2 => exact False.elim (Bool.noConfusion hw)
    | .setTopos => rfl
    | .termTopos => rfl
-- END_BODY ch01:thm:flow-f2-four-rung-escalation

/-- info: 'HomotopyCRM.Vol2.m1_etale_slice_refutes_proj1' does not depend on any axioms -/
#guard_msgs in
#print axioms m1_etale_slice_refutes_proj1

/-- info: 'HomotopyCRM.Vol2.flow_f2_four_rung_strict_escalation' does not depend on any axioms -/
#guard_msgs in
#print axioms flow_f2_four_rung_strict_escalation
