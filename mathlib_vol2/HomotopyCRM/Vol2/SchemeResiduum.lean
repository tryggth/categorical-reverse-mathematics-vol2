  have h2c : (∀ a b : Fin 12, zmod12CRing.dbl b = zmod12CRing.add (zmod12CRing.add (zmod12CRing.mul a b) (zmod12CRing.mul b a)) (zmod12CRing.dbl (zmod12CRing.add b (zmod12CRing.neg (zmod12CRing.mul a b))))) ∧
      (∀ a c : Fin 12, zmod12CRing.zero = zmod12CRing.add (zmod12CRing.add (zmod12CRing.mul a c) (zmod12CRing.mul c a)) (zmod12CRing.dbl (zmod12CRing.neg (zmod12CRing.mul a c)))) := by decide
  have h3c : (∀ a b c : Fin 12, zmod12CRing.tpl c = zmod12CRing.add (zmod12CRing.add (zmod12CRing.mul (zmod12CRing.mul a a) b) (zmod12CRing.mul (zmod12CRing.add (zmod12CRing.mul a b) (zmod12CRing.mul b a)) a)) (zmod12CRing.tpl (zmod12CRing.add c (zmod12CRing.neg (zmod12CRing.mul (zmod12CRing.sq a) b))))) ∧
      (∀ a c : Fin 12, zmod12CRing.zero = zmod12CRing.add (zmod12CRing.add (zmod12CRing.mul (zmod12CRing.mul a a) c) (zmod12CRing.mul (zmod12CRing.add (zmod12CRing.mul a c) (zmod12CRing.mul c a)) a)) (zmod12CRing.tpl (zmod12CRing.neg (zmod12CRing.mul (zmod12CRing.sq a) c)))) := by decide
  have h2 : ∀ x : DualPair (Fin 12), ∃ d : DualPair (Fin 12), (dualPsi2 zmod12CRing).toFun x = (dualPairCRing zmod12CRing).add ((dualPairCRing zmod12CRing).sq x) ((dualPairCRing zmod12CRing).dbl d) := fun ⟨a, b, c⟩ ↦
    let ⟨da, hda⟩ := zmod12FrobLift23.lift2 a; ⟨⟨da, zmod12CRing.add b (zmod12CRing.neg (zmod12CRing.mul a b)), zmod12CRing.neg (zmod12CRing.mul a c)⟩, dualPair_eq hda (h2c.1 a b) (h2c.2 a c)⟩
  have h3 : ∀ x : DualPair (Fin 12), ∃ d : DualPair (Fin 12), (dualPsi3 zmod12CRing).toFun x = (dualPairCRing zmod12CRing).add ((dualPairCRing zmod12CRing).cube x) ((dualPairCRing zmod12CRing).tpl d) := fun ⟨a, b, c⟩ ↦
    let ⟨da, hda⟩ := zmod12FrobLift23.lift3 a; ⟨⟨da, zmod12CRing.add c (zmod12CRing.neg (zmod12CRing.mul (zmod12CRing.sq a) b)), zmod12CRing.neg (zmod12CRing.mul (zmod12CRing.sq a) c)⟩, dualPair_eq hda (h3c.1 a b c) (h3c.2 a c)⟩
  exact ⟨fun n ↦ ⟨delta2Nat_spec n, delta3Nat_spec n⟩, rfl, h2, h3, fun h ↦ Nat.noConfusion (congrArg (fun f ↦ (f.toFun ⟨zmod12CRing.zero, zmod12CRing.zero, zmod12CRing.one⟩).b.1) h)⟩
