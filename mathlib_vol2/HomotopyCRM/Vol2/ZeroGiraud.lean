      · exact False.elim (hn3 hd)
      · exact False.elim (fin4_absurd hdv)
    · exact ⟨E₀, hE₀, (hS₀ d).mpr (fun _ _ ↦ hlt () trivial)⟩

/-- Unconditional (P2) on finite computable chains of Boolean extents in `{ {0,1,2}, Fin 4 }`. -/
theorem p0Cex_P2_bool (cs : List Bool) (hne : cs ≠ []) (d : Fin 4) :
    cs.any (fun b ↦ p0CexBoolExt b d) = p0CexBoolExt (cs.any id) d := by
  induction cs with
  | nil => exact False.elim (hne rfl)
  | cons a tl ih =>
    cases tl with
    | nil => dsimp only [List.any, p0CexBoolExt, id]; cases a <;> cases decide (d.val < 3) <;> rfl
    | cons b rest =>
      change (p0CexBoolExt a d || (b :: rest).any (fun x ↦ p0CexBoolExt x d)) =
        p0CexBoolExt (a || (b :: rest).any id) d
      rw [ih (fun h ↦ by cases h)]; dsimp only [p0CexBoolExt]
      cases a <;> cases (b :: rest).any id <;> cases decide (d.val < 3) <;> rfl

/-- **Independence of (P0) from (P1)–(P5):** On `Fin 4`, `p0CexFamily` satisfies (P1),
    constructive (P2), (P3), (P4), and (P5), yet violates (P0) (`2 ∈ c_ℳ(K) \ T`) and has
    empty Living Zone `ℱ = ∅` (zero axioms). -/
theorem p0_independent_of_p1_p5 :
    ZeroGiraudP1 (ι := Unit) p0CexFamily ∧ ZeroGiraudP3 p0CexDomain p0CexFamily ∧
    ZeroGiraudP4 p0CexDomain p0CexFamily ∧
    ZeroGiraudP5 p0CexDomain p0CexProblem.toDoctrinalProblem p0CexFamily ∧
    (∀ cs : List Bool, cs ≠ [] → ∀ d : Fin 4,
      cs.any (fun b ↦ p0CexBoolExt b d) = p0CexBoolExt (cs.any id) d) ∧
    mooreClosureOf p0CexFamily p0CexProblem.K ⟨2, by decide⟩ ∧
    ¬ AssertoricSet p0CexProblem.toDoctrinalProblem ⟨2, by decide⟩ ∧
    ¬ ZeroGiraudP0 p0CexFamily p0CexProblem.K (AssertoricSet p0CexProblem.toDoctrinalProblem) ∧
    (∀ E, ¬ InLivingZone p0CexFamily p0CexProblem.K
        (AssertoricSet p0CexProblem.toDoctrinalProblem) E) := by
  -- BEGIN_BODY ch01:cex:p0-independent-of-p1-p5
  have hRep := (zero_giraud_representation (ι := Unit) p0CexDomain
    p0CexProblem.toDoctrinalProblem p0CexFamily).mp ⟨p0CexProbe, p0CexProbe_admissible,
    fun _ ↦ Iff.rfl⟩
  have hCl2 : mooreClosureOf p0CexFamily p0CexProblem.K ⟨2, by decide⟩ :=
    fun E ⟨⟨S, hS⟩, _⟩ ↦ (hS ⟨2, by decide⟩).mpr (fun _ _ ↦ nat_lt3_2)
  have hNotT2 : ¬ AssertoricSet p0CexProblem.toDoctrinalProblem ⟨2, by decide⟩ :=
    fun hT ↦ Or.elim hT (fun hnh ↦ hnh nat_lt3_2) (fun hc ↦ Nat.lt_irrefl 2 hc)
  refine ⟨hRep.1, hRep.2.1, hRep.2.2.1, hRep.2.2.2, p0Cex_P2_bool,
    hCl2, hNotT2, fun hP0 ↦ hNotT2 (hP0 ⟨2, by decide⟩ hCl2), ?_⟩
  intro E ⟨⟨S, hS⟩, _, hT⟩
  exact hNotT2 (hT ⟨2, by decide⟩ ((hS ⟨2, by decide⟩).mpr (fun _ _ ↦ nat_lt3_2)))
-- END_BODY ch01:cex:p0-independent-of-p1-p5

